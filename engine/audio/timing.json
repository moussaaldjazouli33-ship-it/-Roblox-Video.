[
 {
  "t0": 0,
  "t1": 0.83,
  "text": "In this town,"
 },
 {
  "t0": 0.83,
  "t1": 2.83,
  "text": "everyone has a bunker except me."
 },
 {
  "t0": 2.83,
  "t1": 2.83,
  "text": "My name is Trevor."
 },
 {
  "t0": 2.83,
  "t1": 4.3,
  "text": "Ten years ago,"
 },
 {
  "t0": 4.3,
  "t1": 6.2,
  "text": "the zombie apocalypse began,"
 },
 {
  "t0": 6.2,
  "t1": 9.31,
  "text": "and every family received an underground bunker."
 },
 {
  "t0": 9.31,
  "t1": 11.11,
  "text": "But each bunker was different."
 },
 {
  "t0": 11.11,
  "t1": 14.46,
  "text": "Bunker number one was made entirely of glass beneath the ocean."
 },
 {
  "t0": 14.46,
  "t1": 18.52,
  "text": "Bunker number seven was a luxury mansion with a swimming pool and unlimited food."
 },
 {
  "t0": 18.52,
  "t1": 20.48,
  "text": "And Bunker number twelve had one rule:"
 },
 {
  "t0": 20.48,
  "t1": 20.48,
  "text": "never make a sound."
 },
 {
  "t0": 20.48,
  "t1": 21.69,
  "text": "But I had no bunker."
 },
 {
  "t0": 21.69,
  "t1": 24.96,
  "text": "I slept inside an abandoned gas station,"
 },
 {
  "t0": 24.96,
  "t1": 26.61,
  "text": "hiding from zombies every night."
 },
 {
  "t0": 26.61,
  "t1": 28.31,
  "text": "Until I noticed something terrifying."
 },
 {
  "t0": 28.31,
  "t1": 29.74,
  "text": "Zombies never attacked me."
 },
 {
  "t0": 29.74,
  "t1": 31.1,
  "text": "They chased everyone else,"
 },
 {
  "t0": 31.1,
  "t1": 33.23,
  "text": "but whenever I walked past,"
 },
 {
  "t0": 33.23,
  "t1": 33.23,
  "text": "they simply stopped and stared."
 },
 {
  "t0": 33.23,
  "t1": 33.23,
  "text": "So one night,"
 },
 {
  "t0": 33.23,
  "t1": 35.69,
  "text": "I followed them to an abandoned hospital."
 },
 {
  "t0": 35.69,
  "t1": 38.92,
  "text": "Beneath it stood a giant metal door marked Bunker one hundred."
 },
 {
  "t0": 38.92,
  "t1": 40.89,
  "text": "The moment I touched it,"
 },
 {
  "t0": 40.89,
  "t1": 40.89,
  "text": "the door opened."
 },
 {
  "t0": 40.89,
  "t1": 42.37,
  "text": "Inside,"
 },
 {
  "t0": 42.37,
  "t1": 45.94,
  "text": "hundreds of monitors showed every bunker in the city."
 },
 {
  "t0": 45.94,
  "t1": 47.91,
  "text": "But one screen displayed a strange message:"
 },
 {
  "t0": 47.91,
  "t1": 49.9,
  "text": "SUBJECT ZERO HAS RETURNED."
 },
 {
  "t0": 49.9,
  "t1": 49.9,
  "text": "Suddenly,"
 },
 {
  "t0": 49.9,
  "t1": 51.27,
  "text": "every screen turned red."
 },
 {
  "t0": 51.27,
  "t1": 52.36,
  "text": "LOCKDOWN INITIATED."
 },
 {
  "t0": 52.36,
  "t1": 54.2,
  "text": "I turned around."
 },
 {
  "t0": 54.2,
  "t1": 55.55,
  "text": "Hundreds of zombies were standing behind me."
 },
 {
  "t0": 55.55,
  "t1": 58.21,
  "text": "But they weren't attacking."
 },
 {
  "t0": 58.21,
  "t1": 58.21,
  "text": "They were bowing."
 },
 {
  "t0": 58.21,
  "t1": 60.45,
  "text": "Then an old recording appeared."
 },
 {
  "t0": 60.45,
  "t1": 62.59,
  "text": "A scientist holding a newborn baby."
 },
 {
  "t0": 62.59,
  "t1": 63.69,
  "text": "That baby was me."
 },
 {
  "t0": 63.69,
  "t1": 64.95,
  "text": "Underneath,"
 },
 {
  "t0": 64.95,
  "t1": 66.34,
  "text": "three words appeared:"
 },
 {
  "t0": 66.34,
  "t1": 66.34,
  "text": "THE FIRST INFECTED."
 },
 {
  "t0": 66.34,
  "t1": 68.95,
  "text": "That's when I understood."
 },
 {
  "t0": 68.95,
  "t1": 71.09,
  "text": "The bunkers weren't built to protect people from zombies."
 },
 {
  "t0": 71.09,
  "t1": 72.99,
  "text": "They were built to protect everyone from me."
 },
 {
  "t0": 72.99,
  "t1": 72.99,
  "text": "But suddenly,"
 },
 {
  "t0": 72.99,
  "t1": 74.63,
  "text": "another message appeared:"
 },
 {
  "t0": 74.63,
  "t1": 76.82,
  "text": "SUBJECT ZERO ACTIVATED."
 },
 {
  "t0": 76.82,
  "t1": 78.56,
  "text": "A countdown began."
 },
 {
  "t0": 78.56,
  "t1": 78.56,
  "text": "ten."
 },
 {
  "t0": 78.56,
  "t1": 78.56,
  "text": "nine."
 },
 {
  "t0": 78.56,
  "t1": 78.56,
  "text": "eight."
 },
 {
  "t0": 78.56,
  "t1": 81.17,
  "text": "Then every bunker door in the city started opening."
 },
 {
  "t0": 81.17,
  "t1": 83.9,
  "text": "And a voice whispered:"
 },
 {
  "t0": 83.9,
  "t1": 84.09,
  "text": "Phase Two has begun."
 }
]